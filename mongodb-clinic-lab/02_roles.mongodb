// Անուն՝ Erik Karapetyan
// Առաջադրանք 2՝ հաշիվներ, դերեր և իրավունքներ
// Ամսաթիվ՝ 2026-11-02
//
// Հանձնվող ֆայլում գաղտնաբառերը փոխարինված են <password>-ով։
// Տեղային գործարկման համար օգտագործել փորձնական գաղտնաբառեր։
// Հատվածները գործարկել նշված հաշիվներով՝ առանձին կապերով։
// Սպասվող մերժումների դեպքում հրամանները գործարկել հերթով,
// որպեսզի մեկ սխալը չկանգնեցնի մնացած փորձերը։
// Ստորև արդյունքները նախորդ իրական փորձարկումներից են․
// կրկին գործարկելիս ID-ները և փոփոխված փաստաթղթերի քանակը կարող են տարբերվել։

use("clinic");

// ============================================================
// 1. Սկզբնական կարգավորում — labAdmin հաշվով
// ============================================================

// Ստեղծել հավաքածուները, եթե դրանք դեռ չկան։

if (!db.getCollectionNames().includes("users")) {
  db.createCollection("users");
}

if (!db.getCollectionNames().includes("appointments")) {
  db.createCollection("appointments");
}

// Արդյունք՝ { ok: 1 }

// Ավելացնել փորձնական փաստաթուղթը, եթե այն դեռ չկա։

if (!db.users.findOne({ email: "matrix@example.com" })) {
  db.users.insertOne({
    name: "Matrix Test",
    email: "matrix@example.com",
    role: "admin",
    active: true,
  });
}

/*
{
  acknowledged: true,
  insertedId: ObjectId('6ae7bad4de3ae95ba005fddc')
}
*/

// Սա կլինիկայի մարդու փաստաթուղթ է, ոչ թե MongoDB մուտքի հաշիվ։
// role: "admin" դաշտը ինքնուրույն սերվերի իրավունքներ չի տալիս։

// ============================================================
// 2. frontdesk դերի ստեղծում — labAdmin հաշվով
// ============================================================

if (!db.getRole("frontdesk")) {
  db.createRole({
    role: "frontdesk",
    privileges: [
      {
        resource: { db: "clinic", collection: "users" },
        actions: ["find", "insert", "update"],
      },
      {
        resource: { db: "clinic", collection: "appointments" },
        actions: ["find", "insert", "update"],
      },
    ],
    roles: [],
  });
}

// Արդյունք՝ { ok: 1 }
// Դերը թույլատրում է կարդալ, ավելացնել և փոփոխել նշված հավաքածուներում։
// roles: [] — այլ դերերից լրացուցիչ իրավունքներ չի ժառանգում։

// ============================================================
// 3. MongoDB հաշիվների ստեղծում — labAdmin հաշվով
// ============================================================

if (!db.getUser("clinicApp")) {
  db.createUser({
    user: "clinicApp",
    pwd: "<password>",
    roles: [{ role: "readWrite", db: "clinic" }],
  });
}

// Արդյունք՝ { ok: 1 }

if (!db.getUser("auditor")) {
  db.createUser({
    user: "auditor",
    pwd: "<password>",
    roles: [{ role: "read", db: "clinic" }],
  });
}

// Արդյունք՝ { ok: 1 }

if (!db.getUser("reception")) {
  db.createUser({
    user: "reception",
    pwd: "<password>",
    roles: [{ role: "frontdesk", db: "clinic" }],
  });
}

// Արդյունք՝ { ok: 1 }

// Կրկին գործարկելու համար վերականգնել clinicApp-ի սկզբնական դերը։
// Նախորդ գործարկման վերջում այն մնացել էր միայն read դերով։
// Այս հրամանը գաղտնաբառը չի փոխում։

db.updateUser("clinicApp", {
  roles: [{ role: "readWrite", db: "clinic" }],
});

// Այս վերականգնման հրամանը նոր ավելացված է․
// արդյունքը գրանցել հաջորդ գործարկման ժամանակ։

// ============================================================
// 4. clinicApp — readWrite դերով
// ============================================================

// Նոր կապ՝
// mongosh "mongodb://localhost:27019/clinic?authSource=clinic" -u clinicApp -p
//
// Փորձերի A–F նույն հրամանները կրկնում ենք յուրաքանչյուր հաշվով։

// A — Կարդալ մեկ փաստաթուղթ։

db.users.findOne();

/*
{
  _id: ObjectId('6ae7bad4de3ae95ba005fddc'),
  name: 'Matrix Test',
  email: 'matrix@example.com',
  role: 'admin',
  active: true
}
*/
// A՝ թույլատրված։

// B — Ավելացնել փորձնական այցելություն։

db.appointments.insertOne({
  doctorId: new ObjectId(),
  patientId: new ObjectId(),
  start: new Date(),
  durationMin: 15,
  reason: "matrix test",
  status: "scheduled",
  fee: 0,
});

/*
{
  acknowledged: true,
  insertedId: ObjectId('6ae7be25026e934c2bbf0642')
}
*/
// B՝ թույլատրված։

// C — Սահմանել Matrix Test-ի հեռախոսահամարը։

db.users.updateOne(
  { email: "matrix@example.com" },
  { $set: { phone: "555-0999" } },
);

/*
{
  acknowledged: true,
  insertedId: null,
  matchedCount: 1,
  modifiedCount: 1,
  upsertedCount: 0
}
*/
// C՝ թույլատրված։

// D — Ջնջել մեկ փորձնական այցելություն։

db.appointments.deleteOne({ reason: "matrix test" });

// Արդյունք՝ { acknowledged: true, deletedCount: 1 }
// D՝ թույլատրված։

// E — Ստեղծել ոչ եզակի ինդեքս email դաշտի վրա։

db.users.createIndex({ email: 1 });

// Արդյունք՝ email_1
// E՝ թույլատրված։

// F — Ստանալ հավաքածուների անունները։

db.getCollectionNames();

// Արդյունք՝ [ 'appointments', 'users' ]
// F՝ թույլատրված։

// ============================================================
// 5. auditor — read դերով
// ============================================================

// Նոր կապ՝
// mongosh "mongodb://localhost:27019/clinic?authSource=clinic" -u auditor -p

// A — Կարդալ մեկ փաստաթուղթ։

db.users.findOne();

/*
{
  _id: ObjectId('6ae7bad4de3ae95ba005fddc'),
  name: 'Matrix Test',
  email: 'matrix@example.com',
  role: 'admin',
  active: true,
  phone: '555-0999'
}
*/
// A՝ թույլատրված։

// B — Փորձել ավելացնել այցելություն։

db.appointments.insertOne({
  doctorId: new ObjectId(),
  patientId: new ObjectId(),
  start: new Date(),
  durationMin: 15,
  reason: "matrix test",
  status: "scheduled",
  fee: 0,
});

// MongoServerError[Unauthorized]: not authorized on clinic to execute
// command { insert: "appointments", ... }
// B՝ մերժված։ Պակասում է insert իրավունքը։

// C — Փորձել սահմանել հեռախոսահամարը։

db.users.updateOne(
  { email: "matrix@example.com" },
  { $set: { phone: "555-0999" } },
);

// MongoServerError[Unauthorized]: not authorized on clinic to execute
// command { update: "users", ... }
// C՝ մերժված։ Պակասում է update իրավունքը։

// D — Փորձել ջնջել այցելությունը։

db.appointments.deleteOne({ reason: "matrix test" });

// MongoServerError[Unauthorized]: not authorized on clinic to execute
// command { delete: "appointments", ... }
// D՝ մերժված։ Պակասում է remove իրավունքը։

// E — Փորձել ստեղծել ինդեքս։

db.users.createIndex({ email: 1 });

// MongoServerError[Unauthorized]: not authorized on clinic to execute
// command { createIndexes: "users", ... }
// E՝ մերժված։ Պակասում է createIndex իրավունքը։

// F — Ստանալ հավաքածուների անունները։

db.getCollectionNames();

// Արդյունք՝ [ 'appointments', 'users' ]
// F՝ թույլատրված։

// ============================================================
// 6. reception — frontdesk դերով
// ============================================================

// Նոր կապ՝
// mongosh "mongodb://localhost:27019/clinic?authSource=clinic" -u reception -p

// A — Կարդալ մեկ փաստաթուղթ։

db.users.findOne();

/*
{
  _id: ObjectId('6ae7bad4de3ae95ba005fddc'),
  name: 'Matrix Test',
  email: 'matrix@example.com',
  role: 'admin',
  active: true,
  phone: '555-0999'
}
*/
// A՝ թույլատրված։

// B — Ավելացնել փորձնական այցելություն։

db.appointments.insertOne({
  doctorId: new ObjectId(),
  patientId: new ObjectId(),
  start: new Date(),
  durationMin: 15,
  reason: "matrix test",
  status: "scheduled",
  fee: 0,
});

/*
{
  acknowledged: true,
  insertedId: ObjectId('6ae7c10b4dbb41af42a274ec')
}
*/
// B՝ թույլատրված։

// C — Սահմանել հեռախոսահամարը։

db.users.updateOne(
  { email: "matrix@example.com" },
  { $set: { phone: "555-0999" } },
);

/*
{
  acknowledged: true,
  insertedId: null,
  matchedCount: 1,
  modifiedCount: 0,
  upsertedCount: 0
}
*/
// C՝ թույլատրված։
// Համարն արդեն նույնն էր, դրա համար modifiedCount: 0 է։

// D — Փորձել ջնջել այցելությունը։

db.appointments.deleteOne({ reason: "matrix test" });

// MongoServerError[Unauthorized]: not authorized on clinic to execute
// command { delete: "appointments", ... }
// D՝ մերժված։ Պակասում է remove իրավունքը։

// E — Փորձել ստեղծել ինդեքս։

db.users.createIndex({ email: 1 });

// MongoServerError[Unauthorized]: not authorized on clinic to execute
// command { createIndexes: "users", ... }
// E՝ մերժված։ Պակասում է createIndex իրավունքը։

// F — Փորձել ստանալ հավաքածուների անունները։

db.getCollectionNames();

// MongoServerError[Unauthorized]: not authorized on clinic to execute command
// { listCollections: 1, filter: {}, cursor: {},
//   nameOnly: true, authorizedCollections: false, ... }
// F՝ մերժված։ Պակասում է listCollections իրավունքը։

// ============================================================
// 7. labAdmin — վերահսկիչ փորձեր
// ============================================================

// Օգտագործել labAdmin կապը՝ clinic բազայում։
// Անհրաժեշտության դեպքում նոր կապ՝
// mongosh "mongodb://localhost:27019/clinic?authSource=admin" -u labAdmin -p

// A — Կարդալ մեկ փաստաթուղթ։

db.users.findOne();

/*
{
  _id: ObjectId('6ae7bad4de3ae95ba005fddc'),
  name: 'Matrix Test',
  email: 'matrix@example.com',
  role: 'admin',
  active: true,
  phone: '555-0999'
}
*/
// A՝ թույլատրված։

// B — Ավելացնել փորձնական այցելություն։

db.appointments.insertOne({
  doctorId: new ObjectId(),
  patientId: new ObjectId(),
  start: new Date(),
  durationMin: 15,
  reason: "matrix test",
  status: "scheduled",
  fee: 0,
});

/*
{
  acknowledged: true,
  insertedId: ObjectId('6ae7c39fde3ae95ba005fddf')
}
*/
// B՝ թույլատրված։

// C — Սահմանել հեռախոսահամարը։

db.users.updateOne(
  { email: "matrix@example.com" },
  { $set: { phone: "555-0999" } },
);

/*
{
  acknowledged: true,
  insertedId: null,
  matchedCount: 1,
  modifiedCount: 0,
  upsertedCount: 0
}
*/
// C՝ թույլատրված։ Համարն արդեն նույնն էր։

// D — Ջնջել մեկ փորձնական այցելություն։

db.appointments.deleteOne({ reason: "matrix test" });

// Արդյունք՝ { acknowledged: true, deletedCount: 1 }
// D՝ թույլատրված։

// E — Ստեղծել ինդեքս։

db.users.createIndex({ email: 1 });

// Արդյունք՝ email_1
// E՝ թույլատրված։ Նույն ինդեքսն արդեն գոյություն ուներ։

// F — Ստանալ հավաքածուների անունները։

db.getCollectionNames();

// Արդյունք՝ [ 'appointments', 'users' ]
// F՝ թույլատրված։

// ============================================================
// 8. Իրական արդյունքների աղյուսակ
// ============================================================

// +՝ թույլատրված, -՝ մերժված։
//
// Գործողություն | clinicApp | auditor | reception | labAdmin
// A            | +         | +       | +         | +
// B            | +         | -       | +         | +
// C            | +         | -       | +         | +
// D            | +         | -       | -         | +
// E            | +         | -       | -         | +
// F            | +         | +       | -         | +
//
// clinicApp-ի արդյունքները վերաբերում են սկզբնական readWrite դերին։

// ============================================================
// 9. Փորձնական այցելությունների մաքրում — labAdmin հաշվով
// ============================================================

db.appointments.deleteMany({ reason: "matrix test" });

// Արդյունք՝ { acknowledged: true, deletedCount: 1 }

// ============================================================
// 10. clinicApp-ից readWrite դերի հեռացում — labAdmin հաշվով
// ============================================================

db.revokeRolesFromUser("clinicApp", [{ role: "readWrite", db: "clinic" }]);

// Արդյունք՝ { ok: 1 }

// Ստուգել հաշվի մնացած դերերը։

db.getUser("clinicApp");

/*
{
  _id: 'clinic.clinicApp',
  userId: UUID('db7cbf08-7b68-4a37-a209-5690d339b4f4'),
  user: 'clinicApp',
  db: 'clinic',
  roles: [],
  mechanisms: [ 'SCRAM-SHA-1', 'SCRAM-SHA-256' ]
}
*/
// Հաշիվը պահպանվել է, բայց roles: [] է։

// Նոր կապ՝
// mongosh "mongodb://localhost:27019/clinic?authSource=clinic" -u clinicApp -p

// B փորձի կրկնում՝ առանց դերի։

db.appointments.insertOne({
  doctorId: new ObjectId(),
  patientId: new ObjectId(),
  start: new Date(),
  durationMin: 15,
  reason: "matrix test",
  status: "scheduled",
  fee: 0,
});

// MongoServerError[Unauthorized]: not authorized on clinic to execute
// command { insert: "appointments", ... }
// B՝ մերժված։ Հաշիվն այլևս insert իրավունք չունի։

// ============================================================
// 11. clinicApp-ին միայն read դերի տրամադրում — labAdmin հաշվով
// ============================================================

db.grantRolesToUser("clinicApp", [{ role: "read", db: "clinic" }]);

// Արդյունք՝ { ok: 1 }

// Նորից միանալ clinicApp հաշվով՝
// mongosh "mongodb://localhost:27019/clinic?authSource=clinic" -u clinicApp -p

// A — Կարդալ մեկ փաստաթուղթ՝ read դերով։

db.users.findOne();

/*
{
  _id: ObjectId('6ae7bad4de3ae95ba005fddc'),
  name: 'Matrix Test',
  email: 'matrix@example.com',
  role: 'admin',
  active: true,
  phone: '555-0999'
}
*/
// A՝ թույլատրված։

// B — Փորձել ավելացնել այցելություն՝ read դերով։

db.appointments.insertOne({
  doctorId: new ObjectId(),
  patientId: new ObjectId(),
  start: new Date(),
  durationMin: 15,
  reason: "matrix test",
  status: "scheduled",
  fee: 0,
});

// Սպասվող արդյունք՝ Unauthorized՝ insert իրավունքի բացակայության պատճառով։
// Վերջին փորձի իրական պատասխանը դեռ չի գրանցվել։

// ============================================================
// 12. Գրավոր պատասխաններ
// ============================================================

// 1. Մերժված գործողությունների պատճառները
//
// auditor-ի B, C, D և E փորձերում պակասում են համապատասխանաբար
// insert, update, remove և createIndex իրավունքները։
// reception-ի D, E և F փորձերում պակասում են համապատասխանաբար
// remove, createIndex և listCollections իրավունքները։
// clinicApp-ից readWrite դերը հեռացնելուց հետո այն կորցրեց insert
// իրավունքը, իսկ հետո տրամադրված read դերն այդ իրավունքը չի տալիս։
// Փորձից պարզեցի, որ find իրավունքը բավարար չէ հավաքածուների
// անունները մեր գործարկած db.getCollectionNames() հրամանով ստանալու համար։

// 2. Ինչպե՞ս թաքցնել հիվանդների ալերգիաները frontdesk-ից
//
// Ալերգիաները կարելի է պահել առանձին՝ patientMedicalDetails հավաքածուում,
// որը հիվանդի փաստաթղթին կապվում է նրա ID-ով։
// frontdesk-ին այդ հավաքածուի նկատմամբ կարդալու իրավունք չենք տա,
// իսկ users-ում կպահենք ընդունարանի համար անհրաժեշտ տվյալները։

// 3. «Դեր» բառի երկու իմաստները
//
// reception հաշվի frontdesk դերը MongoDB սերվերում թույլատրված
// գործողությունների հավաքածու է։
// Dr. Elena Rossi-ի փաստաթղթի role: "doctor" դաշտը նկարագրում է
// նրա աշխատանքը կլինիկայում և ինքնուրույն MongoDB իրավունքներ չի տալիս։