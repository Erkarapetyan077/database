// Անուն՝ Erik Karapetyan
// Առաջադրանք 3՝ տվյալների վավերացում
// Ամսաթիվ՝ 2026-11-02

// Ընտրում ենք clinic փորձնական բազան։
use("clinic");

// Վերաստեղծման համար ջնջում ենք երկու փորձնական հավաքածուներն իրենց տվյալներով։
db.users.drop();
db.appointments.drop();

// true

// Սահմանում ենք օգտատիրոջ դաշտերի կանոնները։
const nameRule = {
  bsonType: "string",
  minLength: 2,
  maxLength: 80,
};

const emailRule = {
  bsonType: "string",
  pattern: "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
};

nameRule;

// { bsonType: "string", minLength: 2, maxLength: 80 }

const phoneRule = {
  bsonType: "string",
  minLength: 7,
  maxLength: 20,
  pattern: "^[0-9+() -]+$",
};

const doctorRule = {
  bsonType: "object",
  required: ["specialty", "licenseNo"],
  properties: {
    specialty: {
      bsonType: "string",
    },
    licenseNo: {
      bsonType: "string",
      pattern: "^MD-[0-9]{4}$",
    },
  },
};

doctorRule;

/*{
  bsonType: 'object',
  required: [ 'specialty', 'licenseNo' ],
  properties: {
    specialty: { bsonType: 'string' },
    licenseNo: { bsonType: 'string', pattern: '^MD-[0-9]{4}$' }
  }
}*/

const patientRule = {
  bsonType: "object",
  required: ["birthDate"],
  properties: {
    birthDate: {
      bsonType: "date",
    },
    bloodType: {
      enum: ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"],
    },
    allergies: {
      bsonType: "array",
      uniqueItems: true,
      items: {
        bsonType: "string",
      },
    },
  },
};

// Նշում ենք պարտադիր և թույլատրելի դաշտերը։ _id-ն նույնպես թույլատրում ենք։
const usersSchema = {
  bsonType: "object",
  required: ["name", "email", "role", "active"],
  additionalProperties: false,
  properties: {
    _id: {},
    name: nameRule,
    email: emailRule,
    phone: phoneRule,
    role: {
      enum: ["doctor", "patient", "admin"],
    },
    active: {
      bsonType: "bool",
    },
    createdAt: {
      bsonType: "date",
    },
    doctor: doctorRule,
    patient: patientRule,
  },
};

usersSchema.oneOf = [
  {
    properties: {
      role: { enum: ["doctor"] },
    },
    required: ["doctor"],
    not: { required: ["patient"] },
  },
  {
    properties: {
      role: { enum: ["patient"] },
    },
    required: ["patient"],
    not: { required: ["doctor"] },
  },
  {
    properties: {
      role: { enum: ["admin"] },
    },
    not: {
      anyOf: [{ required: ["doctor"] }, { required: ["patient"] }],
    },
  },
];

/*[
  {
    properties: { role: { enum: [ 'doctor' ] } },
    required: [ 'doctor' ],
    not: { required: [ 'patient' ] }
  },
  {
    properties: { role: { enum: [ 'patient' ] } },
    required: [ 'patient' ],
    not: { required: [ 'doctor' ] }
  },
  {
    properties: { role: { enum: [ 'admin' ] } },
    not: {
      anyOf: [ { required: [ 'doctor' ] }, { required: [ 'patient' ] } ]
    }
  }
]*/

// Կիրառում ենք users-ի կանոնները բոլոր ավելացումների և թարմացումների համար։
db.createCollection("users", {
  validator: {
    $jsonSchema: usersSchema,
  },
  validationLevel: "strict",
  validationAction: "error",
});

// { ok: 1 }

// Սահմանում ենք դեղի յուրաքանչյուր նշանակման կառուցվածքը։
const prescriptionRule = {
  bsonType: "object",
  required: ["drug", "dose", "days"],
  additionalProperties: false,
  properties: {
    drug: {
      bsonType: "string",
    },
    dose: {
      bsonType: "string",
    },
    days: {
      bsonType: "number",
      minimum: 1,
      maximum: 365,
    },
  },
};

// Սահմանում ենք այցելության դաշտերի տեսակներն ու թույլատրելի արժեքները։
const appointmentsSchema = {
  bsonType: "object",
  required: [
    "doctorId",
    "patientId",
    "start",
    "durationMin",
    "reason",
    "status",
    "fee",
  ],
  additionalProperties: false,
  properties: {
    _id: {},
    doctorId: {
      bsonType: "objectId",
    },
    patientId: {
      bsonType: "objectId",
    },
    start: {
      bsonType: "date",
    },
    durationMin: {
      bsonType: "number",
      minimum: 5,
      maximum: 240,
    },
    reason: {
      bsonType: "string",
      minLength: 3,
      maxLength: 200,
    },
    status: {
      enum: ["scheduled", "completed", "cancelled"],
    },
    fee: {
      bsonType: "number",
      minimum: 0,
    },
    notes: {
      bsonType: "string",
    },
    prescriptions: {
      bsonType: "array",
      maxItems: 10,
      items: prescriptionRule,
    },
  },
};

db.createCollection("appointments", {
  validator: {
    $jsonSchema: appointmentsSchema,
  },
  validationLevel: "strict",
  validationAction: "error",
});
//{ ok: 1 }

// Լրացուցիչ փորձ։ 4 րոպեն փոքր է նվազագույն 5 րոպեից։
db.appointments.insertOne({
  doctorId: new ObjectId(),
  patientId: new ObjectId(),
  start: new Date(),
  durationMin: 4,
  reason: "Validation test",
  status: "scheduled",
  fee: 0,
});

