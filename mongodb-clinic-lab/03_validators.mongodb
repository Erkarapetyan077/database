// C — nurse-ը role-ի թույլատրելի արժեք չէ։
db.users.insertOne({
  name: "Test User",
  email: "test-user@example.com",
  role: "nurse",
  active: true,
});
// Նախորդ փորձի արդյունքը վերևում է՝ consideredValue: 'nurse'։

// D — Առաջադրանքում նշված 0 րոպեն խախտում է minimum: 5 կանոնը։
db.appointments.insertOne({
  doctorId: new ObjectId(),
  patientId: new ObjectId(),
  start: new Date("2026-11-05T10:00:00Z"),
  durationMin: 0,
  reason: "Validation test",
  status: "scheduled",
  fee: 0,
});
// Սպասվում է՝ MongoServerError: Document failed validation

// J — Հիվանդի փաստաթղթում doctor դաշտն արգելված է։
db.users.insertOne({
  name: "Test Patient",
  email: "validation-patient@example.com",
  role: "patient",
  active: true,
  patient: { birthDate: new Date("1995-06-15") },
  doctor: { specialty: "Cardiology", licenseNo: "MD-1234" },
});
// Սպասվում է՝ MongoServerError: Document failed validation

// L–N — Վավեր հիվանդ, ադմին և այցելություն։ Գործարկել որպես մեկ բլոկ։
{
  const doctor = db.users.findOne({
    email: "test-doctor@example.com",
    role: "doctor",
  });
  if (!doctor) throw new Error("Նախ գործարկիր K փորձը՝ վավեր բժշկի ավելացումը։");

  const patientResult = db.users.insertOne({
    name: "Validation Test Patient",
    email: "validation-patient@example.com",
    role: "patient",
    active: true,
    patient: { birthDate: new Date("1995-06-15") },
  });
  printjson(patientResult);
  // L — Սպասվում է acknowledged: true և insertedId։

  const adminResult = db.users.insertOne({
    name: "Validation Test Admin",
    email: "validation-admin@example.com",
    role: "admin",
    active: true,
  });
  printjson(adminResult);
  // M — Սպասվում է acknowledged: true և insertedId։

  const appointmentResult = db.appointments.insertOne({
    doctorId: doctor._id,
    patientId: patientResult.insertedId,
    start: new Date("2026-11-05T10:00:00Z"),
    durationMin: 30,
    reason: "Validation test",
    status: "scheduled",
    fee: 0,
    prescriptions: [{ drug: "Test medicine", dose: "5 mg", days: 3 }],
  });
  printjson(appointmentResult);
  // N — Սպասվում է acknowledged: true և insertedId։

  // Ջնջում ենք փորձնական այցելությունը, հետո երեք օգտատերերին։
  printjson(db.appointments.deleteOne({ _id: appointmentResult.insertedId }));
  printjson(db.users.deleteMany({
    _id: { $in: [doctor._id, patientResult.insertedId, adminResult.insertedId] },
  }));
  // Սպասվում է համապատասխանաբար deletedCount: 1 և deletedCount: 3։
}

// Փորձնական միգրացիա scratch_appointments հավաքածուում։
db.createCollection("scratch_appointments");
// Սպասվում է { ok: 1 }։

db.scratch_appointments.insertMany([
  { reason: "Valid appointment", status: "scheduled", fee: 0 },
  { reason: "Old invalid status", status: "done", fee: 0 },
  { reason: "Old invalid fee", status: "scheduled", fee: -5 },
]);
// Սպասվում է երեք ավելացված փաստաթուղթ։

const scratchSchema = {
  bsonType: "object",
  required: ["status", "fee"],
  properties: {
    status: { enum: ["scheduled", "completed", "cancelled"] },
    fee: { bsonType: "number", minimum: 0 },
  },
};

// i — Սահմանում ենք կանոնները՝ առանց սխալ գրառումներն արգելափակելու։
db.runCommand({
  collMod: "scratch_appointments",
  validator: { $jsonSchema: scratchSchema },
  validationLevel: "moderate",
  validationAction: "warn",
});
// Սպասվում է { ok: 1 }։

// ii — Նոր սխալ գրառումը պահպանվում է, իսկ սերվերը զգուշացում է գրանցում։
db.scratch_appointments.insertOne({
  reason: "New invalid status",
  status: "done",
  fee: 0,
});
// Սպասվում է acknowledged: true։

// iii — moderate-ը չի վավերացնում արդեն անվավեր փաստաթղթի այս փոփոխությունը։
db.scratch_appointments.updateOne(
  { reason: "Old invalid status" },
  { $set: { reason: "Updated old invalid status" } },
);
// Սպասվում է matchedCount: 1, modifiedCount: 1։

// iv — Ցուցադրում ենք սխեմային չհամապատասխանող բոլոր փաստաթղթերը։
db.scratch_appointments.find({
  $nor: [{ $jsonSchema: scratchSchema }],
}).toArray();
// Սպասվում է երեք փաստաթուղթ։

// v — Ուղղում ենք սխալ կարգավիճակներն ու բացասական վճարը։
db.scratch_appointments.updateMany(
  { status: "done" },
  { $set: { status: "completed" } },
);
// Սպասվում է modifiedCount: 2։

db.scratch_appointments.updateMany(
  { fee: { $lt: 0 } },
  { $set: { fee: 0 } },
);
// Սպասվում է modifiedCount: 1։

db.runCommand({
  collMod: "scratch_appointments",
  validationLevel: "strict",
  validationAction: "error",
});
// Սպասվում է { ok: 1 }։

// Կրկնում ենք ii քայլի նույն սխալ ավելացումը։
db.scratch_appointments.insertOne({
  reason: "New invalid status",
  status: "done",
  fee: 0,
});
// Սպասվում է՝ MongoServerError: Document failed validation


// vi — Մերժումը ստանալուց հետո առանձին գործարկել մաքրումը։
db.scratch_appointments.drop();
// Սպասվում է true։

// Ստուգում ենք users հավաքածուի վավերացման կարգավորումները։
const usersOptions = db.getCollectionInfos({ name: "users" })[0].options;
printjson({
  validationLevel: usersOptions.validationLevel,
  validationAction: usersOptions.validationAction,
});
// Սպասվում է { validationLevel: 'strict', validationAction: 'error' }։

// 1. Սխեման կարող է ստուգել, որ doctorId-ն ObjectId է։ Այն չի կարող
// ստուգել՝ այդ ID-ով օգտատեր գոյություն ունի՞ users-ում։ Սխեման նաև
// չի կարող ստուգել՝ այդ օգտատիրոջ դերը doctor է՞։

// 2. strict-ը ստուգում է բոլոր նոր և թարմացվող փաստաթղթերը։
// moderate-ը ստուգում է նոր փաստաթղթերը և արդեն վավեր փաստաթղթերի
// թարմացումները։ moderate-ից կսկսեի հին տվյալների միգրացիայի
// ժամանակ, որպեսզի կարողանամ աստիճանաբար ուղղել անվավեր գրառումները։